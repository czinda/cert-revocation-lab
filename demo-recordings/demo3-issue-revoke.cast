[8.668093, "o", "            Signature Algorithm: ML-DSA-87\r\n            Issuer: C=US, O=Cert-Lab, CN=IoT Sub-CA (ML-DSA-87)\r\n            Subject: CN=demo-device.cert-lab.local, O=Cert-Lab, C=US\r\n                Public Key Algorithm: ML-DSA-87\r\n        Signature Algorithm: ML-DSA-87\r\n"]
[10.670125, "o", "\r\n  Step 4: Revoke certificate (key_compromise)...\r\n"]
[11.87963, "o", "    Revoked certificate \"0xea2b58dfcae9a81a1c7983a9492ba4e6\"\r\n      Serial Number: 0xea2b58dfcae9a81a1c7983a9492ba4e6\r\n      Status: REVOKED\r\n      Revoked On: Thu Jun 25 04:01:21 UTC 2026\r\n      Revoked By: caadmin\r\n"]
