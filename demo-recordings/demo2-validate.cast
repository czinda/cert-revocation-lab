[0.768537, "o", "\u001b[3m                                      Tier 0: System Prerequisites                                      \u001b[0m\r\n┏━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mCheck                  \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mResult\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mMessage                                                          \u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┩\r\n│\u001b[36m \u001b[0m\u001b[36mcommand: podman        \u001b[0m\u001b[36m \u001b[0m│ \u001b[32m✓ PASS\u001b[0m │ found                                                             │\r\n│\u001b[36m \u001b[0m\u001b[36mcommand: podman-compose\u001b[0m\u001b[36m \u001b[0m│ \u001b[32m✓ PASS\u001b[0m │ found                                                             │\r\n│\u001b[36m \u001b[0m\u001b[36mcommand: openssl       \u001b[0m\u001b[36m \u001b[0m│ \u001b[32m✓ PASS\u001b[0m │ found                                                             │\r\n│\u001b[36m \u001b[0m\u001b[36mcommand: curl          \u001b[0m\u001b[36m \u001b[0m│ \u001b[32m✓ PASS\u001b[0m │ found                                                             │\r\n│\u001b[36m \u001b[0m\u001b[36mcommand: jq            \u001b[0m\u001b[36m \u001b[0m│ \u001b[32m✓ PASS\u001b[0m │ found                                                             │\r\n│\u001b[36m \u001b[0m\u001b[36mpodman rootless        \u001b[0m\u001b[36m \u001b[0m│ \u001b[32m✓ PASS\u001b[0m │ linux                                                             │\r\n│\u001b[36m \u001b[0m\u001b[36mpodman rootful         \u001b[0m\u001b[36m \u001b[0m│ \u001b[32m✓ PASS\u001b[0m │ sudo podman available                                             │\r\n│\u001b[36m \u001b[0m\u001b[36m.env configuration     \u001b[0m\u001b[36m \u001b[0m│ \u001b[32m✓ PASS\u001b[0m │ configured                                                        │\r\n│\u001b[36m \u001b[0m\u001b[36mDNS resolution         \u001b[0m\u001b[36m \u001b[0m│ \u001b[31m✗ FAIL\u001b[0m │ root-ca.cert-lab.local does not resolve                           │\r\n│\u001b[36m                         \u001b[0m│        │   \u001b[33mFix: Run: ./scripts/setup-dns.sh (one-time host resolver setup)\u001b[0m │\r\n└─────────────────────────┴────────┴───────────────────────────────────────────────────────────────────┘\r\n"]
