[0.007886, "o", "=== Issuing ML-DSA-87 Certificate from IoT Sub-CA ===\r\n\r\n"]
[0.262306, "o", "\u001b[33mUsage: \u001b[0m\u001b[1;32m-c\u001b[0m issue [OPTIONS]\r\n"]
[0.262637, "o", "\u001b[2mTry \u001b[0m\u001b[2;34m'\u001b[0m\u001b[1;2;34m-c\u001b[0m\u001b[2;34m issue \u001b[0m\u001b[1;2;34m-\u001b[0m\u001b[1;2;34m-help\u001b[0m\u001b[2;34m'\u001b[0m\u001b[2m for help.\u001b[0m\r\n"]
[0.263275, "o", "\u001b[31m╭─\u001b[0m\u001b[31m Error \u001b[0m\u001b[31m─────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[31m─╮\u001b[0m\r\n\u001b[31m│\u001b[0m No such option: \u001b[1;36m-\u001b[0m\u001b[1;36m-cn\u001b[0m                                                                                                 \u001b[31m│\u001b[0m\r\n\u001b[31m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[0.289537, "o", "\r\n=== Verifying Certificate via OCSP ===\r\n\r\n"]
[0.635521, "o", "Usage: -c verify [OPTIONS] SERIAL\r\n"]
[0.636452, "o", "Try '-c verify --help' for help.\r\n"]
[0.637621, "o", "╭─ Error ──────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\r\n│ Missing argument 'SERIAL'.                                                                                           │\r\n╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\r\n"]
