# KMIP Key Management Server
# Provides centralized key lifecycle management across all PKI hierarchies
# using a PyKMIP-based server with a FastAPI management API.
#
# Ports:
#   5696 - KMIP protocol (TLS)
#   8000 - FastAPI management API (HTTP)
#
# Uses Python 3.11 (UBI9) because PyKMIP 0.10 requires ssl.wrap_socket,
# which was removed in Python 3.12.

FROM registry.access.redhat.com/ubi9/python-311:latest

WORKDIR /app

USER 0

COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

COPY app.py .
COPY kmip_server.conf .
COPY entrypoint.sh .
RUN chmod +x entrypoint.sh && \
    mkdir -p /app/certs /var/log/pykmip /app/policies /data/kmip && \
    chown -R 1001:0 /app/certs /var/log/pykmip /app/policies /data/kmip

USER 1001

EXPOSE 5696 8000

ENTRYPOINT ["/app/entrypoint.sh"]
