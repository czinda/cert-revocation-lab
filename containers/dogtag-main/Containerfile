# Dogtag PKI + JSS from Main Branch
#
# Builds both JSS and PKI from upstream master to get unreleased features:
# - JSS PR #1089: ML-KEM KEM encapsulation/decapsulation JNI bindings
# - PKI PR #5362: KRA key recovery wired to JSS KEM decapsulation
#
# Build:
#   podman build -t localhost/dogtag-pki-main:latest -f Containerfile .
#   ./build.sh
#
# The pki-ca image works for CA, KRA, OCSP, and EST/ACME subsystems.
# Subsystem selection happens at runtime via pkispawn or pki-server create.

ARG BASE_IMAGE="registry.fedoraproject.org/fedora:latest"
ARG JSS_REPO="https://github.com/dogtagpki/jss.git"
ARG JSS_BRANCH="master"
ARG PKI_REPO="https://github.com/dogtagpki/pki.git"
ARG PKI_BRANCH="master"

################################################################################
# Stage 0: Build JSS from source (ML-KEM KEM bindings, PR #1089)
################################################################################
FROM $BASE_IMAGE AS jss-builder

ARG JSS_REPO
ARG JSS_BRANCH

RUN dnf install -y dnf-plugins-core git rpm-build \
    && dnf clean all

WORKDIR /root/jss

RUN git clone --depth 1 --branch $JSS_BRANCH $JSS_REPO . \
    && echo "JSS_COMMIT=$(git rev-parse HEAD)" > /root/jss-build-info \
    && echo "JSS_BRANCH=$JSS_BRANCH" >> /root/jss-build-info \
    && echo "JSS_DATE=$(git log -1 --format=%ci)" >> /root/jss-build-info

RUN dnf builddep -y --skip-unavailable jss.spec \
    && dnf clean all

# Disable LTO — GCC 16 on Fedora 44 ICEs in the LTO pass on JNI code
RUN echo '%_lto_cflags %{nil}' >> ~/.rpmmacros \
    && ./build.sh --work-dir=build rpm

################################################################################
# Stage 0b: Lightweight dist holding JSS RPMs
################################################################################
FROM alpine:latest AS jss-dist

COPY --from=jss-builder /root/jss/build/RPMS /root/RPMS/
COPY --from=jss-builder /root/jss-build-info /root/jss-build-info

################################################################################
# Stage 1: Build PKI from source (ML-KEM KRA recovery, PR #5362)
################################################################################
FROM $BASE_IMAGE AS pki-builder

ARG PKI_REPO
ARG PKI_BRANCH

RUN dnf install -y dnf-plugins-core systemd git rpm-build \
    && dnf clean all

WORKDIR /root/pki

RUN git clone --depth 1 --branch $PKI_BRANCH $PKI_REPO . \
    && echo "PKI_COMMIT=$(git rev-parse HEAD)" > /root/pki-build-info \
    && echo "PKI_BRANCH=$PKI_BRANCH" >> /root/pki-build-info \
    && echo "PKI_DATE=$(git log -1 --format=%ci)" >> /root/pki-build-info

RUN dnf builddep -y --skip-unavailable pki.spec \
    && dnf clean all

COPY --from=jss-dist /root/RPMS /tmp/RPMS/
COPY --from=quay.io/dogtagpki/ldapjdk-dist:latest /root/RPMS /tmp/RPMS/

RUN dnf install -y /tmp/RPMS/* \
    && dnf clean all \
    && rm -rf /tmp/RPMS

RUN ./build.sh --work-dir=build rpm

################################################################################
# Stage 2: Lightweight dist image holding only the built RPMs
################################################################################
FROM alpine:latest AS pki-dist

COPY --from=pki-builder /root/pki/build/RPMS /root/RPMS/
COPY --from=pki-builder /root/pki-build-info /root/pki-build-info

################################################################################
# Stage 3: Runtime base with PKI dependencies
################################################################################
FROM $BASE_IMAGE AS pki-runtime

RUN dnf install -y dnf-plugins-core systemd \
    && dnf clean all

RUN dnf install -y dogtag-pki \
    && REGEX="^java-|^dogtag-|^python3-dogtag-" \
    && REGEX="$REGEX|^apache-commons-cli-|^apache-commons-codec-|^apache-commons-io-|^apache-commons-lang3-|^apache-commons-logging-|^apache-commons-net-" \
    && REGEX="$REGEX|^httpcomponents-|^slf4j-" \
    && REGEX="$REGEX|^jakarta-activation-|^jakarta-annotations-|^jaxb-api-" \
    && REGEX="$REGEX|^jboss-logging-|^jboss-jaxrs-2.0-api-" \
    && REGEX="$REGEX|^jackson-|^pki-resteasy-" \
    && rpm -e --nodeps $(rpm -qa | grep -E "$REGEX") \
    && dnf clean all

COPY --from=jss-dist /root/RPMS /tmp/RPMS/
COPY --from=quay.io/dogtagpki/ldapjdk-dist:latest /root/RPMS /tmp/RPMS/
COPY --from=pki-dist /root/RPMS /tmp/RPMS/

RUN dnf install -y /tmp/RPMS/* \
    && dnf clean all \
    && rm -rf /tmp/RPMS

RUN chown -R pkiuser:pkiuser /home/pkiuser

################################################################################
# Stage 4: PKI server setup (NSS, JSS, SSL connector)
################################################################################
FROM pki-runtime AS pki-server

RUN pki-server create \
    --group root \
    --conf /conf \
    --logs /logs

RUN usermod pkiuser -g root

RUN pki-server nss-create --no-password

RUN pki-server jss-enable

RUN pki-server http-connector-add \
    --port 8443 \
    --scheme https \
    --secure true \
    --sslEnabled true \
    --sslProtocol SSL \
    --sslImpl org.dogtagpki.jss.tomcat.JSSImplementation \
    Secure

RUN pki-server http-connector-cert-add \
    --keyAlias sslserver \
    --keystoreType pkcs11 \
    --keystoreProvider Mozilla-JSS

RUN pki-server webapp-deploy \
    --descriptor /usr/share/pki/server/conf/Catalina/localhost/ROOT.xml \
    ROOT

RUN pki-server webapp-deploy \
    --descriptor /usr/share/pki/server/conf/Catalina/localhost/pki.xml \
    pki

RUN cp -r /conf /var/lib/pki/pki-tomcat/conf.default

RUN chown -Rf pkiuser:root /var/lib/pki/pki-tomcat \
    && chmod -Rf g+rw /var/lib/pki/pki-tomcat

VOLUME [ "/certs", "/conf", "/logs" ]

CMD [ "/usr/share/pki/server/bin/pki-server-run" ]

################################################################################
# Stage 5: CA subsystem (final target)
################################################################################
FROM pki-server AS pki-ca

COPY --from=pki-dist /root/pki-build-info /root/pki-build-info
COPY --from=jss-dist /root/jss-build-info /root/jss-build-info

RUN pki-server ca-create
RUN pki-server ca-deploy

RUN cp -r /conf/* /var/lib/pki/pki-tomcat/conf.default

RUN chown -Rf pkiuser:root /var/lib/pki/pki-tomcat \
    && chmod -Rf g+rw /var/lib/pki/pki-tomcat

EXPOSE 8080 8443

CMD [ "/usr/share/pki/ca/bin/pki-ca-run" ]
